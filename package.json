{
  "name": "three-minute-activity-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "postinstall": "npm --prefix game install",
    "build": "npm --prefix game run build && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --exclude 'standalone-game/**' src && node --test server/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm --prefix game test && npm --prefix standalone-game test && npm run test:e2e && npm run build && npm --prefix standalone-game run build",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "docx": "^9.15.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.7",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
